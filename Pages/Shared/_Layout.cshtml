<!DOCTYPE html>

<html lang="ar" dir="rtl" class="lang-ar">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="description" content="نور — رفيقك للصلاة والذكر والقرآن. تطبيق iOS للصلاة، الأذكار، القرآن، والسلاسل — بخصوصية كاملة." />

    <title data-i18n-page="@(ViewData["I18nPage"] ?? "page.index")" data-page-title="@ViewData["Title"]">@ViewData["Title"] — نور</title>

    <link rel="icon" type="image/svg+xml" href="~/images/logo.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

</head>

<body>

    <div class="bg-pattern" aria-hidden="true"></div>



    <header class="site-header" id="top">

        <div class="container header-inner">

            <a class="brand brand-animated" asp-page="/Index" data-i18n-aria="logo.aria">

                <img class="brand-logo-full" data-logo src="~/images/logo-full.svg" data-i18n-alt="logo.alt" alt="نور" width="52" height="66" />

            </a>



            <button class="nav-toggle" type="button" aria-label="Toggle menu" aria-expanded="false">

                <span></span><span></span><span></span>

            </button>



            <nav class="site-nav" aria-label="Main">

                <a href="/#how-it-works" data-i18n="nav.how">كيف يعمل</a>

                <a href="/#features" data-i18n="nav.features">المميزات</a>

                <a href="/#screenshots" data-i18n="nav.screenshots">لقطات من التطبيق</a>

                <a href="/#privacy" data-i18n="nav.privacy">الخصوصية</a>

                <a asp-page="/Privacy" data-i18n="nav.policy">سياسة الخصوصية</a>

                <a href="/#contact" data-i18n="nav.contact">تواصل</a>

            </nav>



            <div class="header-actions">

                <div class="lang-switch" role="group" aria-label="Language">

                    <button type="button" class="lang-btn is-active" data-set-lang="ar" aria-pressed="true">AR</button>

                    <button type="button" class="lang-btn" data-set-lang="en" aria-pressed="false">EN</button>

                </div>

                <a class="btn btn-primary btn-sm header-cta" href="https://apps.apple.com" target="_blank" rel="noopener" data-i18n="nav.download">

                    تحميل التطبيق

                </a>

            </div>

        </div>

    </header>



    <main>

        @RenderBody()

    </main>



    <footer class="site-footer">

        <div class="container footer-grid">

            <div class="footer-brand">

                <a class="brand brand-animated" asp-page="/Index" data-i18n-aria="logo.aria">

                    <img class="brand-logo-full brand-logo-full--sm" data-logo src="~/images/logo-full.svg" data-i18n-alt="logo.alt" alt="نور" width="44" height="56" />

                </a>

                <p class="footer-tagline" data-i18n="footer.tagline">نورٌ على نور — Light upon Light</p>

                <p class="footer-meta">Quran 24:35 · Tanta, Egypt</p>

            </div>

            <div class="footer-links">

                <a href="/#how-it-works" data-i18n="nav.how">How It Works</a>

                <a href="/#features" data-i18n="nav.features">Features</a>

                <a asp-page="/Privacy" data-i18n="nav.policy">Privacy Policy</a>

                <a href="/#contact" data-i18n="nav.contact">Contact</a>

            </div>

            <div class="footer-cta">

                <a class="btn btn-primary" href="https://apps.apple.com" target="_blank" rel="noopener" data-i18n="footer.download">Download on App Store</a>

                <p class="footer-copy">&copy; @DateTime.UtcNow.Year <span data-i18n="footer.copy">Noor App. All rights reserved.</span></p>

            </div>

        </div>

    </footer>



    <script src="~/js/i18n.js" asp-append-version="true"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>

