@page

@model IndexModel

@{
    ViewData["Title"] = "رفيقك للصلاة والذكر والقرآن";
    ViewData["I18nPage"] = "page.index";
}



<section class="hero">

    <div class="container hero-grid">

        <div class="hero-copy">

            <div class="eyebrow" data-i18n="hero.eyebrow">✨ · خصوصية كاملة · بدون تتبع</div>

            <h1 data-i18n="hero.title" data-i18n-html>صلاتك وذكرك وقرآنك<br /><em>في مكان واحد.</em></h1>

            <p class="hero-sub" data-i18n="hero.sub">

                نور يرافقك يومياً — مواقيت دقيقة، أذكار تفاعلية، سلاسل تحفّزك، وقرآن يسير. كل شيء محفوظ على جهازك — بدون جمع بيانات.

            </p>

            <div class="hero-actions">

                <a class="app-store-btn" href="https://apps.apple.com" target="_blank" rel="noopener">

                    <svg class="app-store-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>

                    <span>

                        <small>Download on the</small>

                        <strong>App Store</strong>

                    </span>

                </a>

                <a class="btn btn-outline" href="#features" data-i18n="hero.cta">استكشف المميزات</a>

            </div>

            <div class="hero-badges">

                <span class="badge-pill">🔒 Local storage only</span>

                <span class="badge-pill">🕌 Prayer · Azkar · Quran</span>

                <span class="badge-pill">🔥 Daily streaks</span>

            </div>

        </div>



        <div class="phone-stage">

            <div class="phone">

                <div class="phone-screen">

                    <img class="app-shot" data-shot="moment" src="~/images/screenshots/ar/moment.png" data-i18n-alt="shot.moment" alt="لحظتي — شاشة التطبيق" />

                </div>

            </div>

        </div>

    </div>

</section>



<section id="how-it-works">

    <div class="container">

        <div class="section-head">

            <h2 data-i18n="how.title">كيف يعمل نور</h2>

            <p data-i18n="how.sub">ثلاث خطوات بسيطة لبناء روتين روحي ثابت — بدون تعقيد.</p>

        </div>

        <div class="steps-grid">

            <article class="step-card" data-step="1">

                <h3 data-i18n="how.step1.title">حمّل وفعّل موقعك</h3>

                <p data-i18n="how.step1.body">اسمح بالموقع مرة واحدة لحساب مواقيت الصلاة، اتجاه القبلة، وأقرب المساجد — دون تخزين أو مشاركة.</p>

                <div class="step-shot-wrap">

                    <img class="app-shot" data-shot="prayers" src="~/images/screenshots/ar/prayers.png" data-i18n-alt="shot.prayers" alt="صلاتي — مواقيت الصلاة" />

                </div>

            </article>

            <article class="step-card" data-step="2">

                <h3 data-i18n="how.step2.title">ابنِ يومك الروحي</h3>

                <p data-i18n="how.step2.body">تابع الصلوات، أكمل أذكار الصباح والمساء، واقرأ وردك من القرآن — كل شيء محفوظ على جهازك.</p>

                <div class="step-shot-wrap">

                    <img class="app-shot" data-shot="azkar" src="~/images/screenshots/ar/azkar.png" data-i18n-alt="shot.azkar" alt="أذكاري — أذكار الصباح" />

                </div>

            </article>

            <article class="step-card" data-step="3">

                <h3 data-i18n="how.step3.title">حافظ على سلسلتك</h3>

                <p data-i18n="how.step3.body">تذكيرات لطيفة قبل منتصف الليل، عدّاد تسبيح تفاعلي، ولوحة رحلتك لتشجيعك على الاستمرار.</p>

                <div class="step-shot-wrap">

                    <img class="app-shot" data-shot="journey" src="~/images/screenshots/ar/journey.png" data-i18n-alt="shot.journey" alt="رحلتي — السلاسل والتقدم" />

                </div>

            </article>

        </div>

    </div>

</section>



<section id="features">

    <div class="container">

        <div class="section-head">

            <h2 data-i18n="features.title">كل ما تحتاجه في تطبيق واحد</h2>

            <p data-i18n="features.sub">مصمم للاستخدام اليومي — ليلاً ونهاراً — بأناقة وهدوء.</p>

        </div>



        <div class="feature-row">

            <div class="feature-copy">

                <h3 data-i18n="features.f1.title">لحظتي — إدراك الصلاة</h3>

                <p data-i18n="features.f1.body">عداد تنازلي دقيق للصلاة القادمة، شريط يومي للصلوات الخمس، وتنبيهات قبل انتهاء السلسلة.</p>

                <ul>

                    <li data-i18n="features.f1.li1">مواقيت محسوبة حسب موقعك</li>

                    <li data-i18n="features.f1.li2">عداد متبقٍ مع حلقة تقدم</li>

                    <li data-i18n="features.f1.li3">تذكير: «لا تفوّت السلسلة»</li>

                </ul>

            </div>

            <div class="feature-visual">

                <img class="app-shot" data-shot="moment" src="~/images/screenshots/ar/moment.png" data-i18n-alt="shot.moment" alt="لحظتي — إدراك الصلاة" />

            </div>

        </div>



        <div class="feature-row reverse">

            <div class="feature-copy">

                <h3 data-i18n="features.f2.title">أذكاري — تسبيح تفاعلي</h3>

                <p data-i18n="features.f2.body">أذكار الصباح والمساء وبعد الصلاة مع عدّاد تسبيح، تقدم يومي، وسلاسل تحفّزك على الإتمام.</p>

                <ul>

                    <li data-i18n="features.f2.li1">تبويبات: صباح · مساء · بعد الصلاة</li>

                    <li data-i18n="features.f2.li2">زر «اضغط للتسبيح» مع حلقة تقدم</li>

                    <li data-i18n="features.f2.li3">مصادر الأحاديث والأدعية</li>

                </ul>

            </div>

            <div class="feature-visual">

                <img class="app-shot" data-shot="azkar" src="~/images/screenshots/ar/azkar.png" data-i18n-alt="shot.azkar" alt="أذكاري — تسبيح تفاعلي" />

            </div>

        </div>



        <div class="feature-row">

            <div class="feature-copy">

                <h3 data-i18n="features.f3.title">صلاتي · القرآن · الرحلة</h3>

                <p data-i18n="features.f3.body">جدول صلوات واضح، ورد يومي من القرآن، آية اليوم، استماع للتلاوة، ولوحة رحلتك مع الإحصائيات.</p>

                <ul>

                    <li data-i18n="features.f3.li1">زر «صلّيتُ» بعد وقت الأذان</li>

                    <li data-i18n="features.f3.li2">ورد يومي: ٤ صفحات مع تتبع</li>

                    <li data-i18n="features.f3.li3">تحديات وسلاسل متعددة</li>

                </ul>

            </div>

            <div class="feature-visual">

                <img class="app-shot" data-shot="quran" src="~/images/screenshots/ar/quran.png" data-i18n-alt="shot.quran" alt="القرآن الكريم — ورد اليوم" />

            </div>

        </div>



        <div class="feature-row reverse">

            <div class="feature-copy">

                <h3 data-i18n="features.f4.title">قبلة · مساجد</h3>

                <p data-i18n="features.f4.body">بوصلة القبلة، أقرب مسجد، وحلقة تحفيظ قريبة — كلها حسب موقعك.</p>

                <ul>

                    <li data-i18n="features.f4.li1">بوصلة قبلة دقيقة حسب موقعك</li>

                    <li data-i18n="features.f4.li2">الموقع للخدمة فقط — لا يُرسل لأي جهة</li>

                    <li data-i18n="features.f4.li3">مناسب لجميع الأعمار (4+)</li>

                </ul>

            </div>

            <div class="feature-visual">

                <img class="app-shot" data-shot="prayer-awareness" src="~/images/screenshots/ar/prayer-awareness.png" data-i18n-alt="shot.prayer-awareness" alt="إدراك الصلاة — القبلة والمساجد" />

            </div>

        </div>

    </div>

</section>



